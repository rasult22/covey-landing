---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service — Principle Planner">
  <Header />
  <main class="pt-32 pb-24">
    <article class="container-tight prose prose-invert prose-lg max-w-3xl">
      <h1 class="font-display text-display-sm font-extrabold text-white mb-4">Terms of Service</h1>
      <p class="text-text-muted text-sm mb-12">Last updated: February 2025</p>

      <div class="space-y-8 text-text-secondary">
        <section>
          <h2 class="text-xl font-semibold text-white mb-4">Acceptance of Terms</h2>
          <p class="leading-relaxed">
            By downloading, installing, or using Principle Planner, you agree to be bound by these Terms.
            If you disagree with any part of these Terms, you may not use the App.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">Description of Service</h2>
          <p class="leading-relaxed mb-4">
            Principle Planner is a productivity and planning application based on Stephen Covey's 7 Habits methodology. The App allows you to:
          </p>
          <ul class="list-disc list-inside space-y-2 text-text-secondary">
            <li>Create and manage daily tasks with priorities</li>
            <li>Plan weekly "Big Rocks" (key priorities)</li>
            <li>Define personal mission, values, and roles</li>
            <li>Track goals and achievements</li>
            <li>Visualize tasks using the Quadrant Matrix</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">Subscriptions</h2>
          <p class="leading-relaxed mb-4">
            <strong class="text-white">Free Tier:</strong> The free version includes core features with certain limitations.
          </p>
          <p class="leading-relaxed mb-4">
            <strong class="text-white">Principle Planner Pro:</strong> Unlocks unlimited features. Available as monthly, annual, or lifetime purchase.
          </p>
          <p class="leading-relaxed">
            Subscriptions are processed through Apple's App Store and subject to Apple's terms.
            Payment is charged to your Apple ID at confirmation.
            Subscriptions auto-renew unless cancelled at least 24 hours before the end of the current period.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">Intellectual Property</h2>
          <p class="leading-relaxed">
            The App and its original content are owned by Principle Planner and protected by intellectual property laws.
            The 7 Habits methodology is the property of FranklinCovey Co.
            Principle Planner is an independent implementation and is not affiliated with FranklinCovey Co.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">Disclaimer of Warranties</h2>
          <p class="leading-relaxed uppercase text-sm">
            The app is provided "as is" and "as available" without warranties of any kind, either express or implied.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-4">Contact Us</h2>
          <p class="leading-relaxed">
            If you have any questions about these Terms, please contact us at:
            <a href="mailto:legal@principleplanner.app" class="text-accent hover:underline">legal@principleplanner.app</a>
          </p>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
