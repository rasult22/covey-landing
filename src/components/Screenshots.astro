---
const screenshots = [
  {
    id: 'today',
    title: 'Today View',
    description: 'Plan your day with A-B-C priorities',
    file: 'today.png',
  },
  {
    id: 'matrix',
    title: 'Quadrant Matrix',
    description: 'Visualize urgency vs importance',
    file: 'matrix.png',
  },
  {
    id: 'big-rocks',
    title: 'Big Rocks',
    description: 'Weekly priorities first',
    file: 'big-rocks.png',
  },
  {
    id: 'foundation',
    title: 'Foundation',
    description: 'Mission, Values & Roles',
    file: 'foundation.png',
  },
  {
    id: 'goals',
    title: 'Goals',
    description: 'Long-term goal tracking',
    file: 'goals.png',
  },
];
---

<section id="screenshots" class="section relative overflow-hidden">
  <!-- Background effects -->
  <div class="glow-orb glow-orb-accent w-[500px] h-[500px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20"></div>

  <div class="container-wide relative z-10">
    <!-- Section header -->
    <div class="text-center mb-16 animate-on-scroll">
      <span class="inline-block text-sm font-medium text-accent uppercase tracking-wider mb-4">
        App Screenshots
      </span>
      <h2 class="font-display text-display-sm md:text-display font-extrabold text-white mb-4">
        See It in Action
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        Every screen designed to help you focus on what matters most.
      </p>
    </div>

    <!-- Screenshots carousel -->
    <div class="screenshots-scroll pb-8">
      <div class="screenshots-track">
        {screenshots.map((screenshot, index) => (
          <div class="screenshot-item" style={`--delay: ${index * 100}ms`}>
            <div class="screenshot-card group">
              <!-- iPhone mockup -->
              <div class="iphone-mockup-sm">
                <div class="iphone-frame-sm"></div>
                <div class="iphone-notch-sm"></div>
                <div class="iphone-screen-sm">
                  <img
                    src={`/covey-landing/screenshots/${screenshot.file}`}
                    alt={`${screenshot.title} Screenshot`}
                    class="w-full h-full object-cover object-top"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <!-- Placeholder -->
                  <div class="screenshot-placeholder hidden">
                    <div class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center mb-3">
                      <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                    <p class="text-text-muted text-[10px] text-center leading-tight">
                      {screenshot.file}
                    </p>
                  </div>
                </div>
              </div>

              <!-- Label -->
              <div class="mt-5 text-center">
                <h3 class="text-white font-semibold text-sm mb-1">{screenshot.title}</h3>
                <p class="text-text-muted text-xs">{screenshot.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Scroll hint (mobile) -->
    <div class="flex justify-center md:hidden mt-4">
      <div class="flex items-center gap-2 text-text-muted text-xs">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        Swipe to explore
      </div>
    </div>
  </div>
</section>

<style>
  /* Screenshots horizontal scroll */
  .screenshots-scroll {
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin: 0 -1.5rem;
    padding: 0 1.5rem;
  }

  .screenshots-scroll::-webkit-scrollbar {
    display: none;
  }

  .screenshots-track {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .screenshots-track {
      justify-content: center;
      gap: 2rem;
    }
  }

  .screenshot-item {
    flex-shrink: 0;
    scroll-snap-align: center;
  }

  .screenshot-card {
    position: relative;
    padding: 1rem;
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.4s ease;
  }

  .screenshot-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(34, 197, 94, 0.2);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px -20px rgba(34, 197, 94, 0.15);
  }

  /* Smaller iPhone mockup for screenshots section */
  .iphone-mockup-sm {
    position: relative;
    width: 180px;
    height: 368px;
  }

  @media (min-width: 640px) {
    .iphone-mockup-sm {
      width: 200px;
      height: 408px;
    }
  }

  .iphone-frame-sm {
    position: absolute;
    inset: 0;
    border-radius: 2rem;
    border: 8px solid #1a1a1a;
    background: linear-gradient(145deg, #2a2a2a 0%, #1a1a1a 100%);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 15px 30px -8px rgba(0, 0, 0, 0.8),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .iphone-notch-sm {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 20px;
    background: #1a1a1a;
    border-radius: 0 0 14px 14px;
    z-index: 10;
  }

  .iphone-screen-sm {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #000;
  }

  .iphone-screen-sm img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .screenshot-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #0a0a0a 0%, #111 100%);
    padding: 1rem;
  }

  /* Horizontal scroll snap */
  .screenshots-scroll {
    scroll-snap-type: x mandatory;
  }
</style>
