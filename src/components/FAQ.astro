---
const faqs = [
  {
    question: 'What is the Quadrant Matrix?',
    answer: `The Time Management Matrix divides tasks into four quadrants based on urgency and importance. Quadrant II (important but not urgent) is where you should spend most of your time — this is where long-term success happens. It's the foundation of Covey's time management philosophy.`,
  },
  {
    question: 'What are "Big Rocks"?',
    answer: `Big Rocks are your most important weekly priorities. The metaphor comes from Covey's famous demonstration: if you put big rocks in a jar first, the sand and gravel (small tasks) can fill around them. But if you start with sand, the big rocks won't fit. Schedule your priorities first.`,
  },
  {
    question: 'Is the app free?',
    answer: `Yes! The core features are completely free. Principle Planner Pro unlocks unlimited tasks, goals, advanced analytics, and achievements. Try it free and upgrade when you're ready.`,
  },
  {
    question: 'Which platforms are supported?',
    answer: `Currently iOS (iPhone and iPad). We've built a native iOS experience with smooth animations and intuitive gestures. Android is on our roadmap.`,
  },
  {
    question: 'How is this different from Todoist or Things?',
    answer: `Unlike generic task managers, Principle Planner is built specifically around Covey's 7 Habits methodology. It includes the Quadrant Matrix, Big Rocks planning, and Foundation elements (Mission, Values, Roles) — features designed to help you focus on what truly matters, not just get things done.`,
  },
  {
    question: 'Where is my data stored?',
    answer: `All your data is stored locally on your device. We don't collect or store your personal planning data on any servers. Your mission, values, goals, and tasks stay private on your iPhone or iPad.`,
  },
];
---

<section id="faq" class="section relative">
  <div class="container-tight relative z-10">
    <!-- Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <span class="inline-block text-sm font-medium text-accent uppercase tracking-wider mb-4">
        FAQ
      </span>
      <h2 class="font-display text-display-sm md:text-display font-extrabold text-white">
        Questions?<br />
        <span class="text-gradient">Answers.</span>
      </h2>
    </div>

    <!-- FAQ items -->
    <div class="space-y-4 max-w-3xl mx-auto">
      {faqs.map((faq, index) => (
        <details
          class="group card animate-on-scroll"
          style={`animation-delay: ${index * 100}ms`}
        >
          <summary class="flex items-center justify-between cursor-pointer list-none py-2">
            <span class="text-lg font-medium text-white group-hover:text-accent transition-colors pr-8">
              {faq.question}
            </span>
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-white/5 flex items-center justify-center group-hover:bg-accent/10 transition-colors">
              <svg
                class="w-4 h-4 text-text-muted group-hover:text-accent transition-all group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="pt-4 pb-2 text-text-secondary leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details[open] summary {
    @apply mb-2;
  }

  details summary::-webkit-details-marker {
    display: none;
  }
</style>
