---
// Animated connection graph showing how Mission, Values, Roles, Goals, Big Rocks, and Tasks connect
---

<section id="connections" class="section relative overflow-hidden">
  <div class="container-wide relative z-10">
    <div class="text-center mb-16 animate-on-scroll">
      <span class="inline-block text-sm font-medium text-accent uppercase tracking-wider mb-4">
        Everything Connected
      </span>
      <h2 class="font-display text-display-sm md:text-display font-extrabold text-white mb-6">
        Your Life,<br />
        <span class="text-gradient-accent text-glow">Beautifully Organized</span>
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto leading-relaxed">
        Mission drives values. Values shape roles. Roles define goals.
        Goals become big rocks. Big rocks turn into daily tasks.
        <span class="text-white">Everything flows from your principles.</span>
      </p>
    </div>

    <!-- Graph Container -->
    <div class="relative max-w-4xl mx-auto animate-on-scroll delay-200">
      <!-- Glow effect behind -->
      <div class="absolute inset-0 bg-gradient-radial from-accent/10 via-transparent to-transparent blur-3xl scale-125"></div>

      <!-- SVG Graph -->
      <div class="relative glass rounded-3xl p-4 md:p-8 border border-white/10" id="graph-container">
        <svg
          viewBox="0 0 800 600"
          class="w-full h-auto"
          id="connection-graph"
        >
          <defs>
            <!-- Gradients for links -->
            <linearGradient id="link-mission-value" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#22c55e" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.4"/>
            </linearGradient>
            <linearGradient id="link-mission-role" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#22c55e" stop-opacity="0.8"/>
              <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.4"/>
            </linearGradient>
            <linearGradient id="link-value-goal" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.3"/>
            </linearGradient>
            <linearGradient id="link-role-goal" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#8b5cf6" stop-opacity="0.3"/>
            </linearGradient>
            <linearGradient id="link-goal-rock" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="#22c55e" stop-opacity="0.3"/>
            </linearGradient>
            <linearGradient id="link-rock-task" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#22c55e" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="#ef4444" stop-opacity="0.3"/>
            </linearGradient>

            <!-- Glow filter -->
            <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="6" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>

            <filter id="glow-strong" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="10" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>

          <!-- Connection lines -->
          <g class="links" stroke-width="2" fill="none">
            <!-- Mission to Values (inner ring) -->
            <path class="link link-1" d="M 400,300 Q 340,220 280,180" stroke="url(#link-mission-value)"/>
            <path class="link link-2" d="M 400,300 Q 460,220 520,180" stroke="url(#link-mission-value)"/>
            <path class="link link-3" d="M 400,300 Q 340,380 280,420" stroke="url(#link-mission-value)"/>

            <!-- Mission to Roles (inner ring) -->
            <path class="link link-4" d="M 400,300 Q 300,300 200,300" stroke="url(#link-mission-role)"/>
            <path class="link link-5" d="M 400,300 Q 500,300 600,300" stroke="url(#link-mission-role)"/>
            <path class="link link-6" d="M 400,300 Q 460,380 520,420" stroke="url(#link-mission-role)"/>

            <!-- Values to Goals (cross connections) -->
            <path class="link link-7" d="M 280,180 Q 200,120 130,100" stroke="url(#link-value-goal)"/>
            <path class="link link-8" d="M 520,180 Q 600,120 670,100" stroke="url(#link-value-goal)"/>
            <path class="link link-9" d="M 280,180 Q 350,100 400,60" stroke="url(#link-value-goal)"/>

            <!-- Roles to Goals (cross connections) -->
            <path class="link link-10" d="M 200,300 Q 150,200 130,100" stroke="url(#link-role-goal)"/>
            <path class="link link-11" d="M 600,300 Q 650,200 670,100" stroke="url(#link-role-goal)"/>
            <path class="link link-12" d="M 200,300 Q 280,380 320,480" stroke="url(#link-role-goal)"/>
            <path class="link link-13" d="M 600,300 Q 520,380 480,480" stroke="url(#link-role-goal)"/>

            <!-- Goals to Big Rocks -->
            <path class="link link-14" d="M 130,100 Q 100,160 80,220" stroke="url(#link-goal-rock)"/>
            <path class="link link-15" d="M 400,60 Q 400,120 400,180" stroke="url(#link-goal-rock)"/>
            <path class="link link-16" d="M 670,100 Q 700,160 720,220" stroke="url(#link-goal-rock)"/>

            <!-- Big Rocks to Tasks -->
            <path class="link link-17" d="M 80,220 Q 120,320 160,420" stroke="url(#link-rock-task)"/>
            <path class="link link-18" d="M 400,180 Q 350,280 300,380" stroke="url(#link-rock-task)"/>
            <path class="link link-19" d="M 400,180 Q 450,280 500,380" stroke="url(#link-rock-task)"/>
            <path class="link link-20" d="M 720,220 Q 680,320 640,420" stroke="url(#link-rock-task)"/>

            <!-- Cross connections (showing multi-relationship) -->
            <path class="link link-cross-1" d="M 280,420 Q 350,500 400,540" stroke="url(#link-value-goal)" stroke-dasharray="4,4"/>
            <path class="link link-cross-2" d="M 520,420 Q 450,500 400,540" stroke="url(#link-role-goal)" stroke-dasharray="4,4"/>
            <path class="link link-cross-3" d="M 320,480 Q 360,520 400,540" stroke="url(#link-goal-rock)" stroke-dasharray="4,4"/>
            <path class="link link-cross-4" d="M 480,480 Q 440,520 400,540" stroke="url(#link-goal-rock)" stroke-dasharray="4,4"/>
          </g>

          <!-- Nodes -->
          <g class="nodes">
            <!-- MISSION (center) -->
            <g class="node node-mission" filter="url(#glow-strong)">
              <circle cx="400" cy="300" r="55" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="2" class="mission-outer"/>
              <circle cx="400" cy="300" r="40" fill="#22c55e" fill-opacity="0.3"/>
              <circle cx="400" cy="300" r="28" fill="#22c55e" fill-opacity="0.5"/>
              <text x="400" y="296" text-anchor="middle" fill="white" font-size="11" font-weight="700">MISSION</text>
              <text x="400" y="310" text-anchor="middle" fill="white" font-size="8" fill-opacity="0.8">Be the best version</text>
            </g>

            <!-- VALUES (inner ring - 3 nodes) -->
            <g class="node node-value node-value-1" filter="url(#glow)">
              <circle cx="280" cy="180" r="32" fill="#f59e0b" fill-opacity="0.15" stroke="#f59e0b" stroke-width="2"/>
              <circle cx="280" cy="180" r="22" fill="#f59e0b" fill-opacity="0.4"/>
              <text x="280" y="177" text-anchor="middle" fill="white" font-size="9" font-weight="600">Integrity</text>
              <text x="280" y="188" text-anchor="middle" fill="#fbbf24" font-size="7">Value</text>
            </g>
            <g class="node node-value node-value-2" filter="url(#glow)">
              <circle cx="520" cy="180" r="32" fill="#f59e0b" fill-opacity="0.15" stroke="#f59e0b" stroke-width="2"/>
              <circle cx="520" cy="180" r="22" fill="#f59e0b" fill-opacity="0.4"/>
              <text x="520" y="177" text-anchor="middle" fill="white" font-size="9" font-weight="600">Growth</text>
              <text x="520" y="188" text-anchor="middle" fill="#fbbf24" font-size="7">Value</text>
            </g>
            <g class="node node-value node-value-3" filter="url(#glow)">
              <circle cx="280" cy="420" r="32" fill="#f59e0b" fill-opacity="0.15" stroke="#f59e0b" stroke-width="2"/>
              <circle cx="280" cy="420" r="22" fill="#f59e0b" fill-opacity="0.4"/>
              <text x="280" y="417" text-anchor="middle" fill="white" font-size="9" font-weight="600">Family</text>
              <text x="280" y="428" text-anchor="middle" fill="#fbbf24" font-size="7">Value</text>
            </g>

            <!-- ROLES (inner ring - 3 nodes) -->
            <g class="node node-role node-role-1" filter="url(#glow)">
              <circle cx="200" cy="300" r="30" fill="#3b82f6" fill-opacity="0.15" stroke="#3b82f6" stroke-width="2"/>
              <circle cx="200" cy="300" r="20" fill="#3b82f6" fill-opacity="0.4"/>
              <text x="200" y="297" text-anchor="middle" fill="white" font-size="9" font-weight="600">Father</text>
              <text x="200" y="308" text-anchor="middle" fill="#60a5fa" font-size="7">Role</text>
            </g>
            <g class="node node-role node-role-2" filter="url(#glow)">
              <circle cx="600" cy="300" r="30" fill="#3b82f6" fill-opacity="0.15" stroke="#3b82f6" stroke-width="2"/>
              <circle cx="600" cy="300" r="20" fill="#3b82f6" fill-opacity="0.4"/>
              <text x="600" y="297" text-anchor="middle" fill="white" font-size="9" font-weight="600">Engineer</text>
              <text x="600" y="308" text-anchor="middle" fill="#60a5fa" font-size="7">Role</text>
            </g>
            <g class="node node-role node-role-3" filter="url(#glow)">
              <circle cx="520" cy="420" r="30" fill="#3b82f6" fill-opacity="0.15" stroke="#3b82f6" stroke-width="2"/>
              <circle cx="520" cy="420" r="20" fill="#3b82f6" fill-opacity="0.4"/>
              <text x="520" y="417" text-anchor="middle" fill="white" font-size="9" font-weight="600">Friend</text>
              <text x="520" y="428" text-anchor="middle" fill="#60a5fa" font-size="7">Role</text>
            </g>

            <!-- GOALS (outer ring) -->
            <g class="node node-goal node-goal-1">
              <circle cx="130" cy="100" r="26" fill="#8b5cf6" fill-opacity="0.15" stroke="#8b5cf6" stroke-width="2"/>
              <circle cx="130" cy="100" r="17" fill="#8b5cf6" fill-opacity="0.4"/>
              <text x="130" y="97" text-anchor="middle" fill="white" font-size="7" font-weight="600">Run marathon</text>
              <text x="130" y="107" text-anchor="middle" fill="#a78bfa" font-size="6">Goal</text>
            </g>
            <g class="node node-goal node-goal-2">
              <circle cx="400" cy="60" r="26" fill="#8b5cf6" fill-opacity="0.15" stroke="#8b5cf6" stroke-width="2"/>
              <circle cx="400" cy="60" r="17" fill="#8b5cf6" fill-opacity="0.4"/>
              <text x="400" y="57" text-anchor="middle" fill="white" font-size="7" font-weight="600">Launch app</text>
              <text x="400" y="67" text-anchor="middle" fill="#a78bfa" font-size="6">Goal</text>
            </g>
            <g class="node node-goal node-goal-3">
              <circle cx="670" cy="100" r="26" fill="#8b5cf6" fill-opacity="0.15" stroke="#8b5cf6" stroke-width="2"/>
              <circle cx="670" cy="100" r="17" fill="#8b5cf6" fill-opacity="0.4"/>
              <text x="670" y="97" text-anchor="middle" fill="white" font-size="7" font-weight="600">Read 24 books</text>
              <text x="670" y="107" text-anchor="middle" fill="#a78bfa" font-size="6">Goal</text>
            </g>
            <g class="node node-goal node-goal-4">
              <circle cx="320" cy="480" r="26" fill="#8b5cf6" fill-opacity="0.15" stroke="#8b5cf6" stroke-width="2"/>
              <circle cx="320" cy="480" r="17" fill="#8b5cf6" fill-opacity="0.4"/>
              <text x="320" y="477" text-anchor="middle" fill="white" font-size="7" font-weight="600">Family trip</text>
              <text x="320" y="487" text-anchor="middle" fill="#a78bfa" font-size="6">Goal</text>
            </g>
            <g class="node node-goal node-goal-5">
              <circle cx="480" cy="480" r="26" fill="#8b5cf6" fill-opacity="0.15" stroke="#8b5cf6" stroke-width="2"/>
              <circle cx="480" cy="480" r="17" fill="#8b5cf6" fill-opacity="0.4"/>
              <text x="480" y="477" text-anchor="middle" fill="white" font-size="7" font-weight="600">Learn piano</text>
              <text x="480" y="487" text-anchor="middle" fill="#a78bfa" font-size="6">Goal</text>
            </g>

            <!-- BIG ROCKS (outer) -->
            <g class="node node-rock node-rock-1">
              <rect x="48" y="200" width="64" height="40" rx="8" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="2"/>
              <rect x="55" y="207" width="50" height="26" rx="5" fill="#22c55e" fill-opacity="0.3"/>
              <text x="80" y="218" text-anchor="middle" fill="white" font-size="7" font-weight="600">5K training</text>
              <text x="80" y="228" text-anchor="middle" fill="#4ade80" font-size="6">Big Rock</text>
            </g>
            <g class="node node-rock node-rock-2">
              <rect x="368" y="160" width="64" height="40" rx="8" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="2"/>
              <rect x="375" y="167" width="50" height="26" rx="5" fill="#22c55e" fill-opacity="0.3"/>
              <text x="400" y="178" text-anchor="middle" fill="white" font-size="7" font-weight="600">MVP release</text>
              <text x="400" y="188" text-anchor="middle" fill="#4ade80" font-size="6">Big Rock</text>
            </g>
            <g class="node node-rock node-rock-3">
              <rect x="688" y="200" width="64" height="40" rx="8" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="2"/>
              <rect x="695" y="207" width="50" height="26" rx="5" fill="#22c55e" fill-opacity="0.3"/>
              <text x="720" y="218" text-anchor="middle" fill="white" font-size="7" font-weight="600">Book club</text>
              <text x="720" y="228" text-anchor="middle" fill="#4ade80" font-size="6">Big Rock</text>
            </g>

            <!-- TASKS (outermost) -->
            <g class="node node-task node-task-1">
              <rect x="130" y="405" width="60" height="30" rx="6" fill="#ef4444" fill-opacity="0.15" stroke="#ef4444" stroke-width="1.5"/>
              <text x="160" y="418" text-anchor="middle" fill="white" font-size="7" font-weight="500">Morning run</text>
              <text x="160" y="428" text-anchor="middle" fill="#f87171" font-size="6">Task A</text>
            </g>
            <g class="node node-task node-task-2">
              <rect x="270" y="365" width="60" height="30" rx="6" fill="#ef4444" fill-opacity="0.15" stroke="#ef4444" stroke-width="1.5"/>
              <text x="300" y="378" text-anchor="middle" fill="white" font-size="7" font-weight="500">Code review</text>
              <text x="300" y="388" text-anchor="middle" fill="#f87171" font-size="6">Task A</text>
            </g>
            <g class="node node-task node-task-3">
              <rect x="470" y="365" width="60" height="30" rx="6" fill="#f59e0b" fill-opacity="0.15" stroke="#f59e0b" stroke-width="1.5"/>
              <text x="500" y="378" text-anchor="middle" fill="white" font-size="7" font-weight="500">Write tests</text>
              <text x="500" y="388" text-anchor="middle" fill="#fbbf24" font-size="6">Task B</text>
            </g>
            <g class="node node-task node-task-4">
              <rect x="610" y="405" width="60" height="30" rx="6" fill="#22c55e" fill-opacity="0.15" stroke="#22c55e" stroke-width="1.5"/>
              <text x="640" y="418" text-anchor="middle" fill="white" font-size="7" font-weight="500">Read chapter</text>
              <text x="640" y="428" text-anchor="middle" fill="#4ade80" font-size="6">Task C</text>
            </g>

            <!-- Central task connected to multiple things -->
            <g class="node node-task node-task-central">
              <rect x="365" y="520" width="70" height="35" rx="6" fill="#ef4444" fill-opacity="0.2" stroke="#ef4444" stroke-width="2"/>
              <text x="400" y="534" text-anchor="middle" fill="white" font-size="8" font-weight="600">Family dinner</text>
              <text x="400" y="546" text-anchor="middle" fill="#f87171" font-size="6">Task A</text>
            </g>
          </g>
        </svg>

        <!-- Legend -->
        <div class="flex flex-wrap justify-center gap-4 md:gap-6 mt-6 text-xs md:text-sm">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="text-text-secondary">Mission & Big Rocks</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-amber-500"></div>
            <span class="text-text-secondary">Values</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-blue-500"></div>
            <span class="text-text-secondary">Roles</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-purple-500"></div>
            <span class="text-text-secondary">Goals</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <span class="text-text-secondary">Tasks</span>
          </div>
        </div>

        <!-- Note about connections -->
        <p class="text-center text-text-muted text-xs mt-4">
          Dashed lines show how one task can connect to multiple values and roles
        </p>

        <!-- Controls hint -->
        <div class="flex items-center justify-center gap-4 mt-3 text-text-muted text-xs">
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122" />
            </svg>
            Drag to pan
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
            Scroll to zoom
          </span>
          <button id="reset-view" class="flex items-center gap-1 hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Reset
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Interactive pan & zoom for the graph
  const container = document.getElementById('graph-container');
  const svg = document.getElementById('connection-graph');

  if (container && svg) {
    let viewBox = { x: 0, y: 0, w: 800, h: 600 };
    const initialViewBox = { ...viewBox };

    let isPanning = false;
    let startPoint = { x: 0, y: 0 };
    let scale = 1;
    const minScale = 0.5;
    const maxScale = 3;

    function updateViewBox() {
      svg.setAttribute('viewBox', `${viewBox.x} ${viewBox.y} ${viewBox.w} ${viewBox.h}`);
    }

    function getPointFromEvent(e: MouseEvent | Touch) {
      const rect = svg.getBoundingClientRect();
      return {
        x: (e.clientX - rect.left) / rect.width * viewBox.w + viewBox.x,
        y: (e.clientY - rect.top) / rect.height * viewBox.h + viewBox.y
      };
    }

    // Mouse wheel zoom
    container.addEventListener('wheel', (e) => {
      e.preventDefault();

      // Get cursor position in SVG coordinates BEFORE zoom
      const rect = svg.getBoundingClientRect();
      const cursorX = (e.clientX - rect.left) / rect.width;
      const cursorY = (e.clientY - rect.top) / rect.height;

      const pointX = viewBox.x + cursorX * viewBox.w;
      const pointY = viewBox.y + cursorY * viewBox.h;

      // Inverted: scroll up = zoom in, scroll down = zoom out
      const zoomFactor = e.deltaY < 0 ? 1.15 : 0.87;
      const newScale = Math.max(minScale, Math.min(maxScale, scale * zoomFactor));

      if (newScale !== scale) {
        scale = newScale;

        // Calculate new viewBox dimensions
        const newW = initialViewBox.w / scale;
        const newH = initialViewBox.h / scale;

        // Zoom towards cursor - keep cursor position fixed
        viewBox.x = pointX - cursorX * newW;
        viewBox.y = pointY - cursorY * newH;
        viewBox.w = newW;
        viewBox.h = newH;

        updateViewBox();
      }
    }, { passive: false });

    // Mouse pan
    container.addEventListener('mousedown', (e) => {
      if (e.button === 0) {
        isPanning = true;
        startPoint = { x: e.clientX, y: e.clientY };
        container.style.cursor = 'grabbing';
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (!isPanning) return;

      const rect = svg.getBoundingClientRect();
      const dx = (e.clientX - startPoint.x) / rect.width * viewBox.w;
      const dy = (e.clientY - startPoint.y) / rect.height * viewBox.h;

      viewBox.x -= dx;
      viewBox.y -= dy;

      startPoint = { x: e.clientX, y: e.clientY };
      updateViewBox();
    });

    window.addEventListener('mouseup', () => {
      isPanning = false;
      container.style.cursor = 'grab';
    });

    // Touch support
    let lastTouchDistance = 0;
    let lastTouchCenter = { x: 0, y: 0 };

    container.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        isPanning = true;
        startPoint = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      } else if (e.touches.length === 2) {
        isPanning = false;
        const touch1 = e.touches[0];
        const touch2 = e.touches[1];
        lastTouchDistance = Math.hypot(touch2.clientX - touch1.clientX, touch2.clientY - touch1.clientY);
        lastTouchCenter = {
          x: (touch1.clientX + touch2.clientX) / 2,
          y: (touch1.clientY + touch2.clientY) / 2
        };
      }
    }, { passive: true });

    container.addEventListener('touchmove', (e) => {
      e.preventDefault();

      if (e.touches.length === 1 && isPanning) {
        const rect = svg.getBoundingClientRect();
        const dx = (e.touches[0].clientX - startPoint.x) / rect.width * viewBox.w;
        const dy = (e.touches[0].clientY - startPoint.y) / rect.height * viewBox.h;

        viewBox.x -= dx;
        viewBox.y -= dy;

        startPoint = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        updateViewBox();
      } else if (e.touches.length === 2) {
        const touch1 = e.touches[0];
        const touch2 = e.touches[1];
        const distance = Math.hypot(touch2.clientX - touch1.clientX, touch2.clientY - touch1.clientY);
        const center = {
          x: (touch1.clientX + touch2.clientX) / 2,
          y: (touch1.clientY + touch2.clientY) / 2
        };

        if (lastTouchDistance > 0) {
          const delta = lastTouchDistance / distance;
          const newScale = Math.max(minScale, Math.min(maxScale, scale * delta));

          if (newScale !== scale) {
            const point = getPointFromEvent({ clientX: center.x, clientY: center.y } as MouseEvent);
            const factor = newScale / scale;
            scale = newScale;

            viewBox.x = point.x - (point.x - viewBox.x) * factor;
            viewBox.y = point.y - (point.y - viewBox.y) * factor;
            viewBox.w = initialViewBox.w / scale;
            viewBox.h = initialViewBox.h / scale;

            updateViewBox();
          }
        }

        lastTouchDistance = distance;
        lastTouchCenter = center;
      }
    }, { passive: false });

    container.addEventListener('touchend', () => {
      isPanning = false;
      lastTouchDistance = 0;
    });

    // Reset button
    const resetBtn = document.getElementById('reset-view');
    resetBtn?.addEventListener('click', () => {
      scale = 1;
      viewBox = { ...initialViewBox };
      updateViewBox();
    });

    // Set initial cursor
    container.style.cursor = 'grab';
  }
</script>

