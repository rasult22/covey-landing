---
const features = [
  {
    icon: 'grid',
    title: 'Quadrant Matrix',
    description: 'Visualize tasks by urgency & importance. Focus on Quadrant II for long-term success.',
    color: 'quadrant-2',
    delay: '0',
  },
  {
    icon: 'mountain',
    title: 'Big Rocks First',
    description: 'Schedule your priorities before the gravel fills your calendar. Weekly planning that works.',
    color: 'accent',
    delay: '100',
  },
  {
    icon: 'list',
    title: 'A-B-C Priorities',
    description: 'Know exactly what deserves your attention with the proven prioritization system.',
    color: 'priority-a',
    delay: '200',
  },
  {
    icon: 'compass',
    title: 'Foundation First',
    description: 'Define your Mission, Values, and Roles. Plan from principles, not just tasks.',
    color: 'foundation',
    delay: '300',
  },
];

const icons = {
  grid: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
  </svg>`,
  mountain: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
  </svg>`,
  list: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
  </svg>`,
  compass: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
  </svg>`,
};

const colorClasses: Record<string, string> = {
  'quadrant-2': 'text-green-500 bg-green-500/10 border-green-500/20',
  'accent': 'text-green-500 bg-green-500/10 border-green-500/20',
  'priority-a': 'text-red-500 bg-red-500/10 border-red-500/20',
  'foundation': 'text-white bg-white/5 border-white/10',
};
---

<section id="features" class="section relative overflow-hidden">
  <!-- Background glow -->
  <div class="glow-orb glow-orb-accent w-[500px] h-[500px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-30"></div>

  <div class="container-wide relative z-10">
    <!-- Section header -->
    <div class="text-center mb-16 md:mb-24">
      <span class="inline-block text-sm font-medium text-accent uppercase tracking-wider mb-4">
        Core Features
      </span>
      <h2 class="font-display text-display-sm md:text-display font-extrabold text-white mb-6">
        Everything Covey.<br />
        <span class="text-gradient">Nothing extra.</span>
      </h2>
      <p class="text-text-secondary text-lg max-w-xl mx-auto">
        Every feature is purpose-built around the 7 Habits methodology. No bloat, no distractions.
      </p>
    </div>

    <!-- Features grid - asymmetric layout -->
    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {features.map((feature, index) => (
        <div
          class:list={[
            "card card-glow group animate-on-scroll",
            index === 1 && "md:translate-y-8",
            index === 2 && "md:-translate-y-4",
          ]}
          style={`animation-delay: ${feature.delay}ms`}
        >
          <!-- Icon -->
          <div class:list={["feature-icon mb-6 border", colorClasses[feature.color]]}>
            <Fragment set:html={icons[feature.icon as keyof typeof icons]} />
          </div>

          <!-- Content -->
          <h3 class="text-xl font-semibold text-white mb-3">
            {feature.title}
          </h3>
          <p class="text-text-secondary leading-relaxed">
            {feature.description}
          </p>

          <!-- Hover arrow -->
          <div class="mt-6 flex items-center gap-2 text-sm text-text-muted group-hover:text-accent transition-all">
            <span>Learn more</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
